{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "admin_id": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "country": {
      "type": "string",
      "description": "School's country"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ]
}