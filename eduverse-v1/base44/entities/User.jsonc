{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "school_admin",
        "school_staff",
        "student",
        "professional"
      ],
      "default": "student",
      "description": "User role in the system"
    },
    "country": {
      "type": "string",
      "description": "User's country"
    },
    "education_status": {
      "type": "string",
      "enum": [
        "graduated",
        "not_graduated"
      ],
      "description": "Student education status"
    }
  }
}