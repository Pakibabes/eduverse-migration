{
  "name": "CourseProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "completed_lesson_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_percentage": {
      "type": "number",
      "default": 0
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "quiz_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quiz_id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "passed": {
            "type": "boolean"
          },
          "points_earned": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "course_id"
  ]
}