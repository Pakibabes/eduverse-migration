{
  "name": "CourseTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "course_description": {
      "type": "string"
    },
    "is_paid": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "video",
              "quiz"
            ],
            "default": "text"
          },
          "content": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "number",
            "default": 0
          },
          "order": {
            "type": "number",
            "default": 0
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}