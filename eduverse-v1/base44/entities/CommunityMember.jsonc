{
  "name": "CommunityMember",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "moderator",
        "admin"
      ],
      "default": "member"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "free"
      ],
      "default": "free"
    },
    "joined_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "community_id",
    "user_id"
  ]
}