{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "video",
        "quiz"
      ],
      "default": "text"
    },
    "video_url": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "default": 0
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "course_id",
    "title"
  ]
}