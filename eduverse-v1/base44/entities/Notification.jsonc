{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "reply",
        "new_course",
        "community_added",
        "quiz_passed",
        "points_earned"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ]
}